# ---------------------------------------------------------------------------
# openEther environment. Copy to `.env` and fill in what you need.
# Everything is read at runtime except the two VITE_* build-time values at the
# bottom, which Vite inlines into the dashboard bundle.
# ---------------------------------------------------------------------------

# --- safety ----------------------------------------------------------------
# Master switch for real orders. Default is OFF: every order goes to the
# paper venue and no API key is ever used for signing.
#
# Setting this to 1 only *asks* for live trading. On its own it arms nothing:
# the core also needs a valid arming record at OPENETHER_LIVE_ARMING_FILE.
# The record is written by `openether-live arm`, expires, and is bound to the
# risk configuration it was written with.
OPENETHER_LIVE_TRADING=0
# Path to the live-trading arming record. Leave empty to stay on paper.
OPENETHER_LIVE_ARMING_FILE=
# There is no switch for breaker-reset confirmation: POST /api/breaker/reset
# always requires {"confirm": true} and the risk layer cannot be turned off.
#
# Operator token for the endpoints that can loosen a limit or move money
# (breaker reset, strategy reload/select, wallet sign/broadcast, swap
# execute/approve). Requests send it as `Authorization: Bearer <token>` or
# `X-Admin-Token`. With a token set, reads stay public. It is REQUIRED when
# live trading or the on-chain wallet is armed: the core refuses to start
# without it, because an open port could otherwise reset the breaker.
OPENETHER_ADMIN_TOKEN=
# Optional webhook that receives a JSON alert when the breaker opens or is
# reset. Delivery is fire-and-forget with a 5 s timeout.
OPENETHER_ALERT_WEBHOOK=

# --- core engine -----------------------------------------------------------
CORE_HOST=0.0.0.0
CORE_PORT=8080
# Venue the engine trades on: paper | binance | kraken | hyperliquid
OPENETHER_VENUE=paper
# Symbols the engine subscribes to (comma separated)
OPENETHER_SYMBOLS=SOL/USDT,BTC/USDT,ETH/USDT
# Risk limits
OPENETHER_MAX_POSITION_PCT=20
OPENETHER_MAX_GROSS_EXPOSURE_PCT=60
OPENETHER_MAX_DAILY_LOSS_PCT=3
OPENETHER_MAX_DRAWDOWN_PCT=10
OPENETHER_MAX_OPEN_POSITIONS=5
OPENETHER_MAX_ORDER_NOTIONAL_USD=5000
OPENETHER_MIN_ORDER_NOTIONAL_USD=10
# Portfolio risk: positions that move together share one budget, and entries
# are sized to realized volatility. Set the cluster cap to 0 to disable it.
OPENETHER_MAX_CORRELATED_EXPOSURE_PCT=40
OPENETHER_CORRELATION_THRESHOLD=0.7
OPENETHER_VOLATILITY_TARGET_PCT=2
OPENETHER_VOLATILITY_WINDOW=60
OPENETHER_MIN_SIZE_SCALE=0.25
# Symbols / venues the agent is allowed to touch (comma separated). Anything
# outside the allowlist is rejected by the risk layer.
OPENETHER_SYMBOL_ALLOWLIST=SOL/USDT,BTC/USDT,ETH/USDT
OPENETHER_VENUE_ALLOWLIST=paper
# DEX / protocol addresses the agent may interact with (on-chain allowlist).
OPENETHER_CONTRACT_ALLOWLIST=
# Strategy sandbox. Build the built-ins first with ./scripts/build-strategy.sh,
# which writes rust/target/wasm/{momentum,mean-reversion,breakout}.wasm.
# Comment out to run without a strategy; a missing file only logs a warning.
OPENETHER_STRATEGY_WASM=./rust/target/wasm/momentum.wasm
# Where /api/strategy/select looks for built-in artifacts. The core runs from
# rust/, so target/wasm is rust/target/wasm.
OPENETHER_STRATEGY_DIR=target/wasm
OPENETHER_WASM_FUEL=200000000
# A Rust wasm32 guest needs at least 17 pages (1 MiB stack + data), so the cap
# has to sit above that. 32 pages = 2 MiB.
OPENETHER_WASM_MEMORY_PAGES=32
# Starting balance for the paper venue
OPENETHER_PAPER_CASH=10000
OPENETHER_PAPER_TAKER_FEE_BPS=5
OPENETHER_PAPER_SLIPPAGE_BPS=2
# Durable engine state (SQLite): positions, equity baseline, the trade journal,
# open orders and the circuit-breaker state. Without it a restart resets equity
# to zero and re-opens every risk limit, so a live run must set this.
# Leave empty (or "memory") to keep everything in RAM.
OPENETHER_STATE_DB=./data/openether.db

# --- exchange credentials (only used when live trading is armed) ------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Hyperliquid is read-only: it has no EIP-712 signer, so place_order always
# returns Unsupported. Only the public wallet address is used, for account data.
HYPERLIQUID_WALLET_ADDRESS=

# --- chains ----------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=

# --- AI agent --------------------------------------------------------------
# Provider: local | openai | anthropic | openai-compatible
# `local` is a deterministic offline planner: no API key, no network, useful
# for demos and for keeping the risk layer exercised in CI.
LLM_PROVIDER=local
LLM_MODEL=gpt-4o
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Agent runtime: local | agentkit
AGENT_FRAMEWORK=local
AGENT_INTERVAL_MS=15000
AGENT_MAX_STEPS=6
AGENT_MEMORY_DIR=./data/memory
AGENT_LOG_DIR=./data/logs
AGENT_LOG_LEVEL=info
# Command used to spawn the Rust MCP server over stdio
CORE_MCP_COMMAND=cargo
# The MCP child runs with cwd = ts/packages/agent (pnpm sets it), so the
# manifest path is relative to that directory, not to the repo root.
CORE_MCP_ARGS=run --release -p openether-mcp-server --manifest-path ../../../rust/Cargo.toml
# Command used to spawn the market/on-chain data MCP server over stdio
DATA_MCP_COMMAND=pnpm
DATA_MCP_ARGS=--filter @openether/mcp-data start

# --- wallet ----------------------------------------------------------------
# Encrypted local keystore (AES-256-GCM, Argon2id-derived key). Leave the path
# empty to run without a wallet. The passphrase is never stored or read from
# the environment: it is supplied per signing request and zeroized after use.
OPENETHER_WALLET_KEYSTORE=
# evm | solana
OPENETHER_WALLET_CHAIN=evm
# Dry run refuses live signing and broadcasting. Setting this to 0 allows live
# signing, but a transfer still needs its own on-chain arming record
# (`openether-live arm --target onchain`) and must be under the armed cap.
OPENETHER_WALLET_DRY_RUN=1
# The most this process will ever pay per EVM gas unit, in wei (200 gwei).
# A fee spike above this is a reason to refuse a transfer, not to overpay it.
OPENETHER_BROADCAST_MAX_FEE_PER_GAS_WEI=200000000000
OPENETHER_WALLET_UNLOCK_TIMEOUT_MS=300000
# How many accounts per chain an HD keystore holds. Used by the openether-wallet
# CLI when it creates a keystore.
OPENETHER_WALLET_ACCOUNTS=5
# ERC-20 contracts to value in the wallet panel, comma-separated. Balances are
# read from public addresses only — the keystore is never unlocked to value it.
# Solana SPL tokens are discovered from the address itself and need no list.
OPENETHER_EVM_TOKEN_WATCHLIST=
# DEX feed used to price holdings. A token no pool quotes is shown as unpriced
# and adds nothing to the total.
OPENETHER_PRICE_FEED_URL=https://api.dexscreener.com

# --- on-chain swaps ---------------------------------------------------------
# Quote source. The answer is treated as untrusted: token and amount echoes
# must match, the router and the allowance spender must be on the contract
# allowlist, the native value must match the sale, and the sell side is capped
# by the on-chain arming record. Swaps are EVM only; Solana swaps are refused.
# The template must contain {sell_token}, {buy_token} and {sell_amount}.
# Optional: {chain_id}, {network}, {from}, {sell_decimals}, {buy_decimals},
# {slippage_bps}.
OPENETHER_SWAP_QUOTE_URL=

# --- dashboard -------------------------------------------------------------
VITE_CORE_URL=http://localhost:8080

# --- dashboard build-time values -------------------------------------------
# Base path the built assets are served under. The default matches GitHub
# Pages at https://<user>.github.io/openether/. Use "/" for a custom domain.
VITE_BASE_PATH=/openether/
# SHA-256 hex digest of the admin password, used only when no core is
# reachable (the static/Paged build). With a core, the panel verifies the
# operator token above instead. The password itself is never shipped. Leave
# unset to keep the static fallback permanently locked.
#   printf '%s' 'your-password' | shasum -a 256
VITE_ADMIN_PASSWORD_HASH=
